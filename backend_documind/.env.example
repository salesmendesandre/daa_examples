# Copia este fichero como .env (no se sube a git) y ajusta los valores si hace falta.
PORT=3013
MONGODB_URI=mongodb://127.0.0.1:27017/documind_db
JWT_SECRET=cambia_este_secreto_en_produccion
# Orígenes permitidos por CORS, separados por comas (Vite usa el 5173 por defecto)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Carga usuarios y documentos de demostración al arrancar si la base de datos está vacía
SEED_DEMO_DATA=true
# Retardo entre tokens de POST /api/rag/stream (ms); 0 para desactivarlo
RAG_STREAM_DELAY_MS=40
